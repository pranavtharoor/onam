{
  "name": "onam-sadhya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A cinematic, scroll-driven Onam celebration and Sadhya invitation.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.3d.config.ts",
    "build:2d": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "qa:capture": "node scripts/qa/capture.mjs",
    "qa:motion": "node scripts/qa/motion-strip.mjs",
    "perf:report": "node scripts/perf/report.mjs",
    "assets:images": "node scripts/assets/optimize-images.mjs",
    "assets:svg": "svgo -r -f src/assets/svg --config svgo.config.mjs",
    "assets:video": "bash scripts/assets/encode-video.sh",
    "assets:sequence": "bash scripts/assets/extract-sequence.sh",
    "assets:og": "node scripts/assets/og-image.mjs",
    "assets:3d": "node scripts/assets/build-3d.mjs"
  },
  "dependencies": {
    "@fontsource/manjari": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.56.1",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
